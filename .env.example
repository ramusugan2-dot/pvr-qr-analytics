# Copy this file to .env.local for local development, and add the same
# values in Vercel: Project -> Settings -> Environment Variables.

# Supabase: Project Settings -> API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (older projects call it the "anon public" key). Safe for browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The "secret" key (older projects call it "service_role"). NEVER share this or put it in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The public address of the site, used inside every QR code. No trailing slash.
# Use the Vercel address while testing, then your own domain before printing.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
